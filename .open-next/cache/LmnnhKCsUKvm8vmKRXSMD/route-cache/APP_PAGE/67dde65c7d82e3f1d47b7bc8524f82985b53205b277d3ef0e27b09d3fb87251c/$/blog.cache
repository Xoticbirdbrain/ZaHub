pt></head><body class=\"min-h-full flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><!--&--><!--&--><div class=\"mx-auto w-full max-w-5xl px-4 py-10\"><h1 class=\"text-3xl font-bold\">Blog</h1><p class=\"mt-2 text-zinc-500\">Tips for buyers and sellers.</p><div class=\"mt-6 flex flex-wrap gap-2\"><button class=\"rounded-full border px-4 py-2 text-sm bg-black text-white\">All</button><button class=\"rounded-full border px-4 py-2 text-sm bg-white text-black\">Selling Tips</button><button class=\"rounded-full border px-4 py-2 text-sm bg-white text-black\">Buying Tips</button><button class=\"rounded-full border px-4 py-2 text-sm bg-white text-black\">Guides</button></div><div class=\"mt-8 grid gap-4 md:grid-cols-2\"><div class=\"cursor-pointer rounded-2xl border bg-white p-6 transition hover:shadow-lg\"><p class=\"text-sm text-zinc-500\">Nov 2026<!-- --> · <!-- -->Selling Tips</p><h2 class=\"mt-2 text-xl font-semibold\">How to sell faster on a marketplace</h2><p class=\"mt-2 text-zinc-600\">Clear photos, honest descriptions, and fair pricing make the biggest difference. Here is a simple checklist to get your item sold.</p><p class=\"mt-4 text-sm font-medium\">4 min read<!-- --> →</p></div><div class=\"cursor-pointer rounded-2xl border bg-white p-6 transition hover:shadow-lg\"><p class=\"text-sm text-zinc-500\">Nov 2026<!-- --> · <!-- -->Buying Tips</p><h2 class=\"mt-2 text-xl font-semibold\">How to buy safely from a local seller</h2><p class=\"mt-2 text-zinc-600\">Meet in a public place, check the item before you pay, and ask for the original receipt or box if there is one.</p><p class=\"mt-4 text-sm font-medium\">3 min read<!-- --> →</p></div><div class=\"cursor-pointer rounded-2xl border bg-white p-6 transition hover:shadow-lg\"><p class=\"text-sm text-zinc-500\">Nov 2026<!-- --> · <!-- -->Guides</p><h2 class=\"mt-2 text-xl font-semibold\">What to check before you buy a used car</h2><p class=\"mt-2 text-zinc-600\">Check the service history, look for rust and leaks, test all electronics, and take it for a short drive before you decide.</p><p class=\"mt-4 text-sm font-medium\">5 min read<!-- --> →</p></div><div class=\"cursor-pointer rounded-2xl border bg-white p-6 transition hover:shadow-lg\"><p class=\"text-sm text-zinc-500\">Nov 2026<!-- --> · <!-- -->Guides</p><h2 class=\"mt-2 text-xl font-semibold\">Setting up your first listing</h2><p class=\"mt-2 text-zinc-600\">Pick a clear title, add the price, location, and at least 3 photos. A good first listing takes less than 5 minutes.</p><p class=\"mt-4 text-sm font-medium\">2 min read<!-- --> →</p></div></div></div><!--$--><!--/$--><!--/&--><!--/&--><script src=\"/_next/static/chunks/1pcw6gskne7pf.js\" id=\"_R_\" async=\"\"></script><script>(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/1pcw6gskne7pf.js\",\"static/chunks/3mwm0pfu8c8me.js\",\"static/chunks/41c3808a7as1l.js\",\"static/chunks/2fuxlcqleg9x-.js\"],\"runtimeModuleIds\":[94553]});</script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:\\\"/_next/static/chunks/0wj0noag-9_fs.js\\\"\\n3:I[39756,[\\\"$2\\\"],\\\"default\\\"]\\n4:I[37457,[\\\"$2\\\"],\\\"default\\\"]\\n9:I[47257,[\\\"$2\\\"],\\\"ClientPageRoot\\\"]\\na:\\\"/_next/static/chunks/1lrfrl5gau-g1.js\\\"\\nb:I[27925,[\\\"$2\\\",\\\"$a\\\"],\\\"default\\\"]\\nc:I[97367,[\\\"$2\\\"],\\\"OutletBoundary\\\"]\\nd:\\\"$Sreact.suspense\\\"\\nf:\\\"ViewportBoundary\\\"\\n10:I[97367,[\\\"$2\\\"],\\\"$f\\\"]\\n12:\\\"MetadataBoundary\\\"\\n13:I[97367,[\\\"$2\\\"],\\\"$12\\\"]\\n16:I[68027,[\\\"$2\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/43su91qi057sp.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/07a39a8a4660cc7c-s.p.0r6juujl39pe6.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/605ce01b664af129-s.p.0wgildi0cnwt9.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\